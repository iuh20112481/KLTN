# Enable URL rewriting
RewriteEngine On

# Set the base directory for ROOT deployment
# Sử dụng file này khi deploy vào thư mục ROOT (public_html)
# Đổi tên file này thành .htaccess khi deploy vào root
RewriteBase /

# Rewrite order URL from "chi_tiet_don_hang.php?maVanDon=12345" to "order/12345"
RewriteRule ^order/([0-9a-zA-Z_-]+)$ chi_tiet_don_hang.php?maVanDon=$1 [L]

# Prevent directory listing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8
